# No trailing slash. `node_modules/` matches a DIRECTORY only, so a symlink
# named node_modules is not ignored — and one was committed into this repo
# (mode 120000, pointing at an absolute path on one machine).
node_modules
.relic/
*.tgz
docs/

# Rust build artifacts — the native binary is optional and built locally
rust/target/

# scratch probes — never committed
.tmp/

# bench/ scripts import shared modules (bench_models, report_lang)
__pycache__/
